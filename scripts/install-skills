#!/usr/bin/env python3
# ruff: noqa: E402, I001
"""Thin executable wrapper for the packaged skill installer."""

from __future__ import annotations

import sys
from pathlib import Path

if sys.version_info < (3, 11):  # noqa: UP036 - runs before the 3.11-only imports
    raise SystemExit(f"Linear Spanks needs Python 3.11 or newer; this is {sys.version.split()[0]}.")

PACKAGE_SCRIPTS = Path(__file__).resolve().parents[1] / "skills" / "linear-spanks" / "scripts"
sys.path.insert(0, str(PACKAGE_SCRIPTS))

from linear_spanks.installation.skill_installer import main


if __name__ == "__main__":
    raise SystemExit(main())
