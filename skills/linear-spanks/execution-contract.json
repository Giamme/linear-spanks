    "design-task": {"context": "task", "execution": "preview_write", "session_boundary": "single-command"},
    "create-bug-task": {"context": "task", "execution": "preview_write", "session_boundary": "single-command"},
    "refine-task": {
      "context": "task",
      "execution": "preview_write",
      "orchestration": "task-intake",
      "session_boundary": "single-command",
      "reads": ["team_issue_status_catalog", "human_draft_issue", "current_issue_status", "current_revision"],
      "writes": ["approved_refined_description", "unplanned_status"],
      "postconditions": ["required_statuses_resolved", "human_intent_preserved", "description_and_status_read_back", "milestone_fit_next_step_reported"]
    },
    "plan-task": {
      "context": "task",
      "execution": "invocation_write",
      "orchestration": "planning",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-command",
      "reads": ["team_issue_status_catalog", "refined_task_contract", "current_issue_status", "repository_evidence", "bounded_learning_entries", "milestone_dependency_graph_when_bound"],
      "writes": ["authoritative_current_plan", "backlog_status", "managed_unreviewed_dependency_graph_when_bound"],
      "postconditions": ["required_statuses_resolved", "plan_revision_read_back", "backlog_status_read_back", "dependency_graph_refreshed_when_milestone_bound", "no_implementation"]
    },
    "organize-unplanned": {
      "context": "intake",
      "execution": "conditional_proposal_write",
      "session_boundary": "single-command",
      "bulk": true,
      "reads": ["team_issue_status_catalog", "unplanned_task_contract_matrix", "existing_milestone_contracts", "project_spec", "bounded_learning_entries"],
      "writes": ["approved_milestone_membership", "approved_new_milestone", "approved_complementary_unplanned_tasks"],
      "postconditions": ["required_statuses_resolved", "every_candidate_has_placement_decision", "all_writes_read_back", "unapproved_operations_omitted"]
    },
    "run-task": {
      "context": "task",
      "execution": "invocation_write",
      "orchestration": "task-execution",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-task",
      "reads": ["target_issue_full", "planned_issue_readiness", "milestone_contract_compact", "blocker_status_matrix", "unfinished_or_consumed_blocker_contracts", "authoritative_current_plan", "bounded_sibling_contracts", "bounded_learning_entries", "repository_evidence"],
      "writes": ["claim_when_configured", "in_progress_state", "plan_revision_when_required", "completion_receipt", "done_state"],
      "postconditions": ["human_draft_or_unplanned_rejected", "hard_blockers_done", "verification_passed", "completion_receipt_read_back", "done_state_read_back", "newly_unblocked_relations_read"]
    },
    "replan-task": {
      "context": "task",
      "execution": "invocation_write",
      "orchestration": "planning",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-command",
      "reads": ["authoritative_current_plan", "implementation_drift_evidence", "milestone_dependency_graph_when_bound"],
      "writes": ["new_plan_revision", "current_plan_pointer", "managed_unreviewed_dependency_graph_when_bound"],
      "postconditions": ["superseded_plans_excluded_from_active_context", "dependency_graph_refreshed_when_milestone_bound"]
    },
    "review-task-scope": {"context": "task", "execution": "read_report", "session_boundary": "single-command"},
    "decompose-task": {"context": "task", "execution": "read_report", "session_boundary": "single-command"},
    "split-task": {"context": "task", "execution": "preview_write", "session_boundary": "single-command", "bulk": true},
    "promote-task": {"context": "task", "execution": "preview_write", "session_boundary": "single-command", "bulk": true},
    "verify-task": {
      "context": "task",
      "execution": "invocation_write",
      "orchestration": "task-verification",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-command",
      "reads": ["task_acceptance_criteria", "fresh_verification_evidence"],
      "writes": ["completion_receipt", "done_state_on_success"],
      "postconditions": ["each_acceptance_criterion_verified", "failed_verification_remains_in_progress"]
    },
    "backfill-completion": {"context": "task", "execution": "invocation_write", "session_boundary": "single-command", "repository_scan": {"default_tier": "fast"}},

    "implement-next": {
      "context": "lifecycle",
      "execution": "invocation_write",
      "orchestration": "task-execution",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-task",
      "reads": ["compact_milestone_task_matrix", "blocker_status_matrix", "selected_task_repository_trace_revision"],
      "writes": ["selected_task_execution_operations"],
      "postconditions": ["selection_total_order_recorded", "exactly_one_task_selected"]
    },
    "implement-wave": {
      "context": "lifecycle",
      "execution": "invocation_write",
      "orchestration": "parallel-execution",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-wave",
      "bulk": true,
      "reads": ["reviewed_dependency_graph", "compact_milestone_task_matrix", "blocker_status_matrix", "current_plan_revisions", "clean_parent_branch_and_head", "harness_parallel_capacity"],
      "writes": ["durable_wave_receipt", "serial_task_claims", "isolated_child_branches", "clean_task_worktrees", "verified_task_commits"],
      "postconditions": ["fixed_frontier_recorded", "every_task_isolated_from_exact_baseline", "successful_tasks_verified_pending_integration", "no_issue_marked_done", "next_wave_blocked_on_failure"]
    },
    "reconcile-wave": {
      "context": "lifecycle",
      "execution": "preview_write",
      "orchestration": "wave-reconciliation",
      "repository_scan": {"default_tier": "fast"},
      "session_boundary": "single-wave",
      "bulk": true,
      "reads": ["reviewed_dependency_graph", "current_plan_revisions", "wave_receipt", "child_branch_heads", "clean_current_parent"],
      "writes": ["temporary_integration_branch_and_worktree", "approved_merge_commits", "verified_parent_advance", "completion_receipts", "done_states", "safe_worktree_cleanup", "approved_merged_branch_deletion"],
      "postconditions": ["exact_preview_approval_satisfied", "parent_unchanged_on_combined_verification_failure", "independent_conflicts_preserved", "integrated_issues_done_and_read_back", "newly_unblocked_relations_read"]
    },
    "status-milestone": {
      "context": "lifecycle",
      "execution": "read_report",
      "session_boundary": "single-command",
      "reads": ["compact_milestone_task_matrix", "bounded_blocker_graph", "managed_dependency_graph_when_present", "harness_parallel_capacity", "milestone_runtime_storage_and_projection"],
      "postconditions": ["status_counts_reconcile_with_matrix", "runtime_storage_policy_wave_plan_review_and_repair_reported", "parallel_or_sequential_next_command_recommended"]
    },
    "pause-milestone": {"context": "lifecycle", "execution": "invocation_write", "session_boundary": "single-command"},
    "resume-milestone": {"context": "lifecycle", "execution": "preview_write", "session_boundary": "single-command"},
    "sync-milestone": {"context": "lifecycle", "execution": "conditional_write", "session_boundary": "single-command"},
    "archive-milestone": {"context": "lifecycle", "execution": "preview_write", "session_boundary": "single-command", "bulk": true},
    "trace-blockers": {
      "context": "lifecycle",
      "execution": "read_report",
      "session_boundary": "single-command",
      "reads": ["bounded_blocker_status_graph", "unfinished_or_contract_relevant_blockers"],
      "postconditions": ["depth_and_node_limits_reported"]
    },
    "diff-milestone": {"context": "lifecycle", "execution": "read_report", "session_boundary": "single-command"},
    "handoff-milestone": {
      "context": "lifecycle",
      "execution": "read_report",
      "session_boundary": "single-command",
      "reads": ["validated_state_marker", "compact_milestone_task_matrix", "open_findings", "milestone_runtime_storage_and_projection"],
      "postconditions": ["source_revisions_and_next_command_included", "runtime_policy_wave_plan_review_and_repair_included"]
    },
    "onboard-milestone": {"context": "lifecycle", "execution": "preview_write", "session_boundary": "single-command"},
    "onboard-task": {"context": "lifecycle", "execution": "preview_write", "session_boundary": "single-command"},

    "review-learnings": {"context": "learning", "execution": "read_report", "session_boundary": "single-command"},
    "apply-learnings": {"context": "learning", "execution": "read_report", "session_boundary": "single-command"},
    "organize-learnings": {"context": "learning", "execution": "conditional_write", "session_boundary": "single-command", "bulk": true}
  }
}
