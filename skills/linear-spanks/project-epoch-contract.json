{
  "schema_version": 1,
  "capsule": {
    "title": "Active Project Context",
    "max_body_bytes": 24576,
    "required_fields": [
      "schema_version",
      "project_id",
      "project_revision",
      "label",
      "generated_at",
      "body",
      "source_snapshot_hash",
      "batches",
      "coverage",
      "next_command"
    ],
    "required_headings": [
      "## Current Baseline",
      "## Delivered Outcomes",
      "## Active Frontier",
      "## Decisions and Constraints",
      "## Risks, Debt, and Open Questions",
      "## Resource Map",
      "## Learning Links",
      "## Provenance and Resume"
    ],
    "inventory": {
      "max_batches": 64,
      "max_compact_rows_per_batch": 30,
      "max_full_entities_per_batch": 12
    },
    "batch_fields": [
      "batch_id",
      "compact_rows",
      "full_entities",
      "source_ids"
    ],
    "coverage_fields": [
      "expected_source_ids",
      "covered_source_ids",
      "excluded_sources"
    ],
    "exclusion_fields": [
      "source_id",
      "reason"
    ],
    "overflow_result": "CONTEXT_OVERFLOW"
  },
  "rollover": {
    "receipt_title_prefix": "Project Rollover Receipt — ",
    "phases": [
      "inventory",
      "preview",
      "successor-created",
      "roadmap-created",
      "carryover-created",
      "source-resolved",
      "finalized"
    ],
    "initial_phase": "inventory",
    "terminal_phase": "finalized",
    "transitions": {
      "inventory": ["inventory", "preview"],
      "preview": ["preview", "successor-created"],
      "successor-created": ["successor-created", "roadmap-created"],
      "roadmap-created": ["roadmap-created", "carryover-created"],
      "carryover-created": ["carryover-created", "source-resolved"],
      "source-resolved": ["source-resolved", "finalized"],
      "finalized": ["finalized"]
    },
    "required_fields": [
      "schema_version",
      "run_id",
      "phase",
      "source_project",
      "successor_project",
      "next_release",
      "initiative",
      "source_snapshot_hash",
      "approved_plan_hash",
      "capsule",
      "roadmap_items",
      "carryovers",
      "milestone_dispositions",
      "issue_dispositions",
      "unresolved_source_items",
      "applied_operation_ids",
      "read_back_ids",
      "next_command",
      "updated_at"
    ],
    "project_fields": ["project_id", "revision", "status"],
    "capsule_fields": [
      "document_id",
      "revision",
      "content_hash",
      "source_snapshot_hash",
      "status"
    ],
    "capsule_statuses": ["draft", "prepared", "finalized"],
    "initiative_fields": [
      "source_initiative_id",
      "requested_initiative_id",
      "successor_initiative_id",
      "warning"
    ],
    "roadmap_item_fields": [
      "proposal_id",
      "successor_milestone_id",
      "objective",
      "read_back"
    ],
    "carryover_fields": [
      "source_issue_id",
      "source_revision",
      "successor_issue_id",
      "successor_status",
      "provenance_linked",
      "read_back"
    ],
    "milestone_disposition_fields": [
      "source_milestone_id",
      "disposition",
      "approved",
      "resolved"
    ],
    "milestone_dispositions": ["wrapped", "archived", "canceled"],
    "issue_disposition_fields": [
      "source_issue_id",
      "disposition",
      "approved",
      "resolved"
    ],
    "issue_dispositions": ["completed", "superseded", "canceled"],
    "successor_issue_status": "Unplanned",
    "min_roadmap_items": 3,
    "max_roadmap_items": 7,
    "completed_project_status": "Completed",
    "drift_result": "ROLLOVER_DRIFT"
  }
}
